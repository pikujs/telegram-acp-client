[Unit]
Description=Telegram ACP Bot - %i
After=network.target

[Service]
Type=simple
# %i is the instance name (e.g. 'mybot' in telegram-acp-client@mybot.service)
# The bot will automatically find its config in the platform-specific user config dir
ExecStart=/usr/bin/env telegram-acp-client run %i
Restart=on-failure

[Install]
WantedBy=default.target
